# Dependencias
/vendor/

# Cache de PHPUnit
/.phpunit.cache/

# Entorno
/.env
/config/provider.local.php

# IDEs
.idea/
.vscode/

# Logs
*.log

# Correos registrados por LogMailer (ver versions.md v2.11): pueden
# contener tokens de verificacion, no deben versionarse.
/storage/mails/*
!/storage/mails/.gitkeep

# Archivos temporales
*.tmp
*.swp
.DS_Store
Thumbs.db

# ADS de Windows
*:Zone.Identifier
