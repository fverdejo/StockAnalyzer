# Dependencias
/vendor/

# Cache de PHPUnit
/.phpunit.cache/

# Artefactos de la verificacion visual con Playwright (ver versions.md v2.81):
# capturas de pantalla y scripts de comprobacion de un solo uso. Acaban en el
# directorio del proyecto porque es la unica via para sacar ficheros del
# contenedor web al host, pero no son codigo de la aplicacion. Convencion:
# nombrarlos siempre con el prefijo .tmp-
/.tmp-*

# Entorno
/.env
/config/provider.local.php

# IDEs
.idea/
.vscode/

# Logs
*.log

# Correos registrados por LogMailer (ver versions.md v2.11): pueden
# contener tokens de verificacion, no deben versionarse.
/storage/mails/*
!/storage/mails/.gitkeep

# Archivos temporales
*.tmp
*.swp
.DS_Store
Thumbs.db

# ADS de Windows
*:Zone.Identifier

# Volcados de datos para trasvasar entre entornos (no son codigo y pesan MB).
/storage/exports/
